# Allowlist: send the builder only what the Dockerfile copies. Anything new at the
# top level stays local until it is added here, so backups, databases, caches, and
# secrets can't leak into the build context by accident.
#
# If a COPY in the Dockerfile fails with "not found", add the path below.
#
# https://docs.docker.com/build/concepts/context/#dockerignore-files

*

!mix.exs
!mix.lock
!config
!lib
!priv
!assets
!rel
!litestream.yml

# Built inside the image, so skip local copies
/assets/node_modules/
/priv/static/assets/
/priv/static/cache_manifest.json
**/.DS_Store
