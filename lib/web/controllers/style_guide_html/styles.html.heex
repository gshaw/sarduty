<%!-- The guide's own frame: its bar, side nav, page text, and the boxes examples sit in. Every
example inside a .demo or .example comes from the app's stylesheet alone, so it looks as it
does in the app. The page-text rules skip anything inside one. --%>
<style>
  /* Sticky, like the app's fixed bar, so iOS fills the area under the clock with its navy. */
  .guide-bar { position: sticky; top: 0; z-index: 45; background: var(--nav); color: #fff; border-bottom: 4px solid var(--accent); }
  html { scroll-padding-top: 80px; }
  .guide-bar .container { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-5); height: 56px; }
  .guide-bar .brand { color: #fff; font-weight: 700; font-size: var(--fs-lg); line-height: var(--lh-lg); text-decoration: none; }
  .guide-bar .brand span { color: var(--accent); }
  .guide-bar .brand small { color: #aeb8c4; font-weight: 400; font-size: var(--fs-sm); margin-left: var(--sp-2); }
  .guide-tabs { display: flex; gap: var(--sp-1); margin-right: auto; align-self: stretch; }
  .guide-tabs a { display: flex; align-items: center; padding: 0 var(--sp-3); color: #d5dbe3; font-size: var(--fs-sm); line-height: var(--lh-sm); text-decoration: none; border-bottom: 4px solid transparent; margin-bottom: -4px; }
  .guide-tabs a:hover { color: #fff; text-decoration: underline; }
  .guide-tabs a[aria-current] { color: #fff; font-weight: 700; border-bottom-color: #fff; }
  .theme-switch { display: flex; border: 1px solid rgb(255 255 255 / 0.3); border-radius: var(--radius); }
  .theme-switch button { background: none; border: 0; color: #d5dbe3; font-size: var(--fs-xs); line-height: var(--lh-xs); padding: var(--sp-1) var(--sp-3); cursor: pointer; }
  .theme-switch button[aria-pressed="true"] { background: rgb(255 255 255 / 0.16); color: #fff; }

  .container { max-width: 1280px; margin: 0 auto; padding: 0 var(--sp-5); }
  .guide { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: var(--sp-6); padding-top: var(--sp-6); padding-bottom: var(--sp-8); }
  .guide-nav ul { position: sticky; top: calc(60px + var(--sp-5)); }
  .guide-nav a { display: block; padding: var(--sp-1) var(--sp-3); font-size: var(--fs-sm); line-height: var(--lh-sm); color: var(--text); text-decoration: none; border-left: 4px solid transparent; }
  .guide-nav a:hover { color: var(--link-hover); text-decoration: underline; }
  .guide-nav a[aria-current="page"] { border-left-color: var(--primary); font-weight: 700; background: var(--surface-alt); }

  /* Page text, outside the examples. */
  .guide-main :is(h1, h2, h3, h4):not(.demo *, .example *, .table-wrap *) { font-weight: 700; margin: 0 0 var(--sp-3); }
  .guide-main h1:not(.demo *, .example *, .table-wrap *) { font-size: var(--fs-2xl); line-height: var(--lh-2xl); }
  .guide-main h2:not(.demo *, .example *, .table-wrap *) { font-size: var(--fs-xl); line-height: var(--lh-xl); margin-top: var(--sp-7); }
  .guide-main h3:not(.demo *, .example *, .table-wrap *) { font-size: var(--fs-lg); line-height: var(--lh-lg); margin-top: var(--sp-5); }
  .guide-main h4:not(.demo *, .example *, .table-wrap *) { font-size: var(--fs-md); line-height: var(--lh-md); margin-top: var(--sp-4); margin-bottom: var(--sp-2); }
  .guide-main :is(p, ul, ol):not(.demo *, .example *, .table-wrap *) { margin: 0 0 var(--sp-4); }
  .guide-main :is(p, li):not(.demo *, .example *, .table-wrap *) { max-width: 70ch; }
  .guide-main :is(ul, ol):not(.demo *, .example *, .table-wrap *) { padding-left: var(--sp-5); }
  .guide-main ul:not(.demo *, .example *, .table-wrap *) { list-style: disc; }
  .guide-main ol:not(.demo *, .example *, .table-wrap *) { list-style: decimal; }
  .guide-main li + li:not(.demo *, .example *, .table-wrap *) { margin-top: var(--sp-1); }
  .guide-main a:not(.demo *, .example *, .table-wrap *, .guide-nav *) { color: var(--link); text-decoration: underline; text-underline-offset: 0.15em; text-decoration-thickness: 1px; }
  .guide-main a:hover:not(.demo *, .example *, .table-wrap *, .guide-nav *) { color: var(--link-hover); text-decoration-thickness: 3px; }
  .guide-main code:not(.demo *, .example *, .table-wrap *) { font-size: 0.875em; }
  .guide-main .first { margin-top: 0 !important; }

  /* Examples: .demo is boxed, .example is not. */
  .demo { border: 1px solid var(--border-subtle); padding: var(--sp-5); margin-bottom: var(--sp-5); border-radius: var(--radius); }
  .demo > :last-child, .example > :last-child { margin-bottom: 0; }
  .example { margin-bottom: var(--sp-5); }
  .spec { font-size: var(--fs-sm); line-height: var(--lh-sm); color: var(--text-muted); margin-top: calc(-1 * var(--sp-3)); margin-bottom: var(--sp-5); max-width: 70ch; }

  /* The app's bar, menu, and toasts are fixed or floating in the app. Here they sit in place. */
  .demo .site-bar { position: relative; }
  .bar-demo { padding-bottom: 200px !important; }
  /* The phone bar at any window width: the menu button, not the links. */
  .phone-bar-demo :is(.site-bar-links, .site-bar-link, .site-bar-menu) { display: none; }
  .phone-bar-demo .site-bar-phone { display: block; }
  .phone-bar-demo { padding-bottom: 560px !important; }
  .demo .toasts { position: static; width: auto; max-width: 400px; }
  .phone-width { max-width: 390px; }

  /* Frozen states, so every state of a button or switch can be seen at once. */
  .btn.is-hover { background: var(--btn-bg-hover); }
  .btn-link.is-hover { color: var(--link-hover); text-decoration: underline 3px; }
  .btn.is-active { background: var(--btn-bg-hover); transform: translateY(2px); box-shadow: none; }
  .btn.is-focus { outline: 3px solid transparent; background: var(--focus); color: #0b0c0c; box-shadow: 0 2px 0 #0b0c0c; text-decoration: none; }
  .is-focus input.switch { outline: 3px solid var(--focus); box-shadow: inset 0 0 0 2px #0b0c0c; }

  /* Colours and logo pages: light and dark side by side. */
  .modes { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--border-subtle); margin-bottom: var(--sp-6); }
  .mode { background: var(--bg); color: var(--text); padding: var(--sp-5); }
  .swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: var(--sp-3); margin-bottom: var(--sp-5); }
  .swatch { font-size: var(--fs-xs); line-height: var(--lh-xs); }
  .swatch .chipcolor { height: 44px; border-radius: var(--radius); border: 1px solid var(--border-subtle); margin-bottom: var(--sp-1); }
  .swatch strong { display: block; font-family: var(--mono); }
  .swatch span { color: var(--text-muted); font-family: var(--mono); }
  .logo-forms, .logo-ladder { display: flex; gap: var(--sp-5); align-items: end; flex-wrap: wrap; }
  .logo-ladder { gap: var(--sp-4); }
  .mode figure, .logo-ladder figure { margin: 0; text-align: center; }
  .mode figcaption, .logo-ladder figcaption { font-size: var(--fs-sm); line-height: var(--lh-sm); color: var(--text-muted); margin-top: var(--sp-2); }
  .logo-wide { margin-top: var(--sp-5) !important; text-align: left !important; }
  .logo-wide .site-bar { position: relative; z-index: auto; }

  /* Spacing page */
  .space-bar { display: inline-block; height: 16px; background: var(--primary); vertical-align: middle; }

  /* Writing page: docs/writing.md, rendered as the app renders Markdown. */
  .prose td:first-child { white-space: nowrap; }

  @media (max-width: 800px) {
    .container { padding: 0 var(--sp-4); }
    .guide { grid-template-columns: minmax(0, 1fr); gap: var(--sp-4); padding-top: var(--sp-4); }
    .guide-nav ul { position: static; display: flex; flex-wrap: wrap; gap: var(--sp-1); }
    .guide-bar .container { flex-wrap: wrap; height: auto; padding-top: var(--sp-2); row-gap: 0; }
    /* The four tabs share the width and never scroll. */
    .guide-tabs { order: 3; width: 100%; margin-right: 0; justify-content: space-between; gap: 0; }
    .guide-tabs a { padding: var(--sp-2) var(--sp-1); white-space: nowrap; }
    .guide-nav a { border: 1px solid var(--border-subtle); border-radius: var(--radius); }
    .guide-nav a[aria-current="page"] { border-color: var(--primary); }
    .modes { grid-template-columns: minmax(0, 1fr); }
    .guide-bar .brand small { display: none; }
  }
  @media (max-width: 360px) {
    .guide-tabs a { font-size: var(--fs-xs); line-height: var(--lh-xs); }
  }
</style>
