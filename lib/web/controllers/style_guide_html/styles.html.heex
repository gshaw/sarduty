<%!-- The guide's own frame: its bar, side nav, page text, and the boxes examples sit in. Every
example inside a .demo or .example comes from the app's stylesheet alone, so it looks as it
does in the app. The page-text rules skip anything inside one. --%>
<style>
  /* Under the app's fixed bar, which is 52px and its 4px rule. */
  html { scroll-padding-top: 80px; }
  .container { max-width: 1280px; margin: 0 auto; padding-inline: var(--sp-6); }
  .guide { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: var(--sp-8); padding-top: calc(56px + var(--sp-8)); padding-bottom: var(--sp-16); }
  .guide > .side-nav { width: auto; }

  /* The side nav: the groups a size up, and the pages tighter, so more of a long group fits.
     Touch screens keep 44px rows. */
  .guide > .side-nav .guide-groups a { font-size: var(--fs-md); line-height: var(--lh-md); }
  .guide > .side-nav .guide-pages a { padding-top: var(--sp-1); padding-bottom: var(--sp-1); }

  /* Auto, Light, and Dark, at the foot of the side nav and on the phone Menu's navy. */
  .guide-theme { display: flex; flex-direction: column; align-items: flex-start; gap: var(--sp-2); padding: var(--sp-2) var(--sp-3) 0; color: var(--text-muted); font-size: var(--fs-sm); line-height: var(--lh-sm); }
  .theme-switch { display: flex; border: 1px solid var(--border); border-radius: var(--radius); }
  .theme-switch button { background: none; border: 0; color: var(--text); font-size: var(--fs-xs); line-height: var(--lh-xs); padding: var(--sp-1) var(--sp-3); cursor: pointer; }
  .theme-switch button[aria-pressed="true"] { background: var(--surface-alt); font-weight: 700; }
  .site-bar-phone-panel .guide-theme { padding: var(--sp-2) var(--sp-4); color: rgb(255 255 255 / 0.6); }
  .site-bar-phone-panel .theme-switch { border-color: rgb(255 255 255 / 0.3); }
  .site-bar-phone-panel .theme-switch button { color: #d5dbe3; font-size: var(--fs-sm); line-height: var(--lh-sm); padding: var(--sp-2) var(--sp-4); }
  .site-bar-phone-panel .theme-switch button[aria-pressed="true"] { background: rgb(255 255 255 / 0.16); color: #fff; }

  /* Page text, outside the examples. */
  .guide-main :is(h1, h2, h3, h4):not(.demo *, .example *, .table-wrap *) { font-weight: 700; margin: 0 0 var(--sp-3); }
  .guide-main h1:not(.demo *, .example *, .table-wrap *) { font-size: var(--fs-2xl); line-height: var(--lh-2xl); }
  .guide-main h2:not(.demo *, .example *, .table-wrap *) { font-size: var(--fs-xl); line-height: var(--lh-xl); margin-top: var(--sp-12); }
  .guide-main h3:not(.demo *, .example *, .table-wrap *) { font-size: var(--fs-lg); line-height: var(--lh-lg); margin-top: var(--sp-6); }
  .guide-main h4:not(.demo *, .example *, .table-wrap *) { font-size: var(--fs-md); line-height: var(--lh-md); margin-top: var(--sp-4); margin-bottom: var(--sp-2); }
  .guide-main :is(p, ul, ol):not(.demo *, .example *, .table-wrap *) { margin: 0 0 var(--sp-4); }
  .guide-main :is(p, li):not(.demo *, .example *, .table-wrap *) { max-width: 70ch; }
  .guide-main :is(ul, ol):not(.demo *, .example *, .table-wrap *) { padding-left: var(--sp-6); }
  .guide-main ul:not(.demo *, .example *, .table-wrap *) { list-style: disc; }
  .guide-main ol:not(.demo *, .example *, .table-wrap *) { list-style: decimal; }
  .guide-main li + li:not(.demo *, .example *, .table-wrap *) { margin-top: var(--sp-1); }
  .guide-main a:not(.demo *, .example *, .table-wrap *, .breadcrumbs *) { color: var(--link); text-decoration: underline; text-underline-offset: 0.15em; text-decoration-thickness: 1px; }
  .guide-main a:hover:not(.demo *, .example *, .table-wrap *, .breadcrumbs *) { color: var(--link-hover); text-decoration-thickness: 3px; }
  .guide-main code:not(.demo *, .example *, .table-wrap *) { font-size: 0.875em; }
  .guide-main .first { margin-top: 0 !important; }

  /* The breadcrumbs keep the app's look, not the page text's list. */
  .guide-main ol.breadcrumbs { padding-left: 0; margin: 0 0 var(--sp-4); list-style: none; }
  .guide-main ol.breadcrumbs li { margin: 0; }

  /* Examples: .demo is boxed, .example is not. */
  .demo { border: 1px solid var(--border-subtle); padding: var(--sp-6); margin-bottom: var(--sp-6); border-radius: var(--radius); }
  .demo > :last-child, .example > :last-child { margin-bottom: 0; }
  .example { margin-bottom: var(--sp-6); }
  .spec { font-size: var(--fs-sm); line-height: var(--lh-sm); color: var(--text-muted); margin-top: calc(-1 * var(--sp-3)); margin-bottom: var(--sp-6); max-width: 70ch; }

  /* The app's bar, menu, and toasts are fixed or floating in the app. Here they sit in place. */
  .demo .site-bar { position: relative; }
  .bar-demo { padding-bottom: 320px !important; }
  .phone-bar-demo { padding-bottom: 1000px !important; }
  .switcher-demo { padding-bottom: 240px !important; }
  .switcher-demo:not(:has([open])) { padding-bottom: 0 !important; }
  .demo .toasts { position: static; width: auto; max-width: 400px; }
  /* Search's panel in place, on a navy strip like the bar, with the page's dimming left out. */
  .search-demo { background: var(--nav); }
  .search-demo .site-search.is-open .site-search-dim { display: none; }
  .search-demo .site-search.is-open .site-search-panel { position: static; margin-top: var(--sp-2); width: auto; max-width: 560px; }
  .phone-width { max-width: 390px; }

  /* Frozen states, so every state of a button or switch can be seen at once. */
  .btn.is-hover { background: var(--btn-bg-hover); }
  .btn-link.is-hover { color: var(--link-hover); text-decoration: underline 3px; }
  .btn.is-active { background: var(--btn-bg-hover); transform: translateY(2px); box-shadow: none; }
  .btn.is-focus { outline: 3px solid transparent; background: var(--focus); color: #0b0c0c; box-shadow: 0 2px 0 #0b0c0c; text-decoration: none; }
  .btn-link.is-focus { border-radius: 0; box-shadow: none; background: linear-gradient(#0b0c0c, #0b0c0c) 0 calc(100% + 4px) / 100% 4px no-repeat, linear-gradient(var(--focus), var(--focus)) 0 -2px / 100% calc(100% + 2px) no-repeat; background-origin: content-box; }
  .is-focus input.switch { outline: 3px solid var(--focus); box-shadow: inset 0 0 0 2px #0b0c0c; }

  /* Colours and logo pages: light and dark side by side. */
  .modes { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--border-subtle); margin-bottom: var(--sp-8); }
  .mode { background: var(--bg); color: var(--text); padding: var(--sp-6); }
  .swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: var(--sp-3); margin-bottom: var(--sp-6); }
  .swatch { font-size: var(--fs-xs); line-height: var(--lh-xs); }
  .swatch .chipcolor { height: 44px; border-radius: var(--radius); border: 1px solid var(--border-subtle); margin-bottom: var(--sp-1); }
  .swatch strong { display: block; font-family: var(--mono); }
  .swatch span { color: var(--text-muted); font-family: var(--mono); }
  .logo-forms, .logo-ladder { display: flex; gap: var(--sp-6); align-items: end; flex-wrap: wrap; }
  .logo-ladder { gap: var(--sp-4); }
  .mode figure, .logo-ladder figure { margin: 0; text-align: center; }
  .mode figcaption, .logo-ladder figcaption { font-size: var(--fs-sm); line-height: var(--lh-sm); color: var(--text-muted); margin-top: var(--sp-2); }
  .logo-wide { margin-top: var(--sp-6) !important; text-align: left !important; }
  .logo-wide .site-bar { position: relative; z-index: auto; }

  /* Spacing page */
  .space-bar { display: inline-block; height: 16px; background: var(--primary); vertical-align: middle; }

  /* Writing page: docs/writing.md, rendered as the app renders Markdown. */
  .prose td:first-child { white-space: nowrap; }

  /* Below 1024px the side nav hides, as the app's does, and the bar's Menu holds it. */
  @media (width < 64rem) {
    .guide { display: block; padding-top: calc(56px + var(--sp-6)); }
  }
  @media (max-width: 800px) {
    .container { padding-inline: var(--sp-4); }
    .modes { grid-template-columns: minmax(0, 1fr); }
  }
</style>
