<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>{page_title(@current)} · SAR Duty style guide</title>
    <%!-- The bar's navy, as in the app, so iOS fills the area under the clock with it. --%>
    <meta name="theme-color" content="#13243a" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a111b" media="(prefers-color-scheme: dark)" />
    <%!-- Before first paint, so a saved theme doesn't flash. --%>
    <script src={~p"/assets/js/styles_theme.js"}>
    </script>
    <Web.Layouts.favicon_links />
    <%!-- The app's stylesheet, so every example looks as it does in the app. --%>
    <link rel="stylesheet" href={~p"/assets/css/app.css"} />
    <%!-- Mounts the hooks examples need, such as the combobox's, and connects the search. --%>
    <script type="module" src={~p"/assets/js/styles.js"}>
    </script>
    <.styles />
  </head>
  <body>
    <%!-- The app's own bar, as on the home page: your team with the switcher, or Log in.
    Below 1024px its Menu holds the side nav. --%>
    <Web.Layouts.main_nav_bar
      current_user={@current_user}
      current_team={@current_team}
      managed_teams={@managed_teams}
      member_logins={@member_logins}
      user_organizations={@user_organizations}
      current_path={@conn.request_path}
      pages={nav_sections(@current)}
    >
      <:search>
        {live_render(@conn, Web.StyleGuideSearchLive, container: {:div, class: "contents"})}
      </:search>
      <:menu_foot>
        <hr />
        <.theme_switch />
      </:menu_foot>
    </Web.Layouts.main_nav_bar>
    {@inner_content}
    <Web.Components.Messages.confirm_dialog />
  </body>
</html>
