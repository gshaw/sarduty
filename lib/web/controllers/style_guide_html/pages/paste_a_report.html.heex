<.shell title="Paste a report" current={:paste_a_report}>
  <h1>Paste a report</h1>
  <p class="lead">Turn a pasted attendance report into changes to review.</p>

  <div class="example measure" onsubmit="return false">
    <.paste_report />
  </div>

  <h2>How it works</h2>
  <ul>
    <li>One big text area and one button. The hint says how members are matched.</li>
    <li>
      Nothing changes yet. The next page lists the changes to <a href={page_path(:review_changes)}>review</a>.
    </li>
  </ul>
  <p class="spec">
    <code>&lt;.paste_report /&gt;</code> from <code>Web.Components.AttendanceImport</code>.
  </p>
</.shell>
