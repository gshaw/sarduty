<.shell title="Back link" current={:back_link}>
  <h1>Back link</h1>
  <p class="lead">A way back for pages outside the main tree.</p>

  <div class="demo">
    <.back_link navigate="#">Team settings</.back_link>
  </div>

  <h2>When to use</h2>
  <p>At the top of a page outside the main tree, such as settings, instead of breadcrumbs.</p>

  <h2>When not to use</h2>
  <p>A page under a section's list. Use <a href={page_path(:breadcrumbs)}>breadcrumbs</a>.</p>

  <h2>In the app</h2>
  <p>
    <code>&lt;.back_link navigate=&#123;…&#125;&gt;Team settings&lt;/.back_link&gt;</code>. The text names the page it goes back to.
  </p>
</.shell>
