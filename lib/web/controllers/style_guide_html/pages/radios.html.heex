<.shell title="Radios" current={:radios}>
  <h1>Radios</h1>
  <p class="lead">One answer from a short list.</p>
  <.used_on />

  <div class="demo">
    <fieldset class="mb-p">
      <legend class="font-semibold">Hours to count</legend>
      <label class="flex items-center gap-2 my-1">
        <input type="radio" name="e-hours" checked /> Primary and secondary
      </label>
      <label class="flex items-center gap-2 my-1">
        <input type="radio" name="e-hours" /> Primary only
      </label>
    </fieldset>
  </div>

  <h2>When to use</h2>
  <p>Exactly one answer from a few choices that people should see side by side.</p>

  <h2>When not to use</h2>
  <ul>
    <li>A long list. Use a select.</li>
    <li>Any number of answers. Use <a href={page_path(:checkboxes)}>checkboxes</a>.</li>
  </ul>

  <h2>In the app</h2>
  <p>A <code>&lt;fieldset&gt;</code> of labelled radios, the same markup as a checkbox list.</p>
</.shell>
