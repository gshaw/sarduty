<.shell current={:fix_form_errors}>
  <h1>Fix form errors</h1>
  <p class="lead">Team settings' Tax credit letters tab after a failed save.</p>

  <.form :let={f} for={settings_form()} class="example measure" onsubmit="return false">
    <.error_summary form={f} />
    <.input field={f[:mailing_address]} label="Mailing address" type="textarea" rows="3" />
    <.input
      field={f[:authorized_by_name]}
      label="Tax credit letters authorized by"
      type="textarea"
      rows="3"
    >
      The full name of your team president, or someone in a similar role. The CRA uses this during
      tax audits.
    </.input>
    <div class="grid md:grid-cols-2 gap-x-6">
      <.input field={f[:authorized_by_phone]} label="Signer's phone (optional)" />
      <.input field={f[:authorized_by_email]} label="Signer's email (optional)" type="email" />
    </div>
    <.form_actions>
      <.button variant={:success}>Save settings</.button>
    </.form_actions>
  </.form>

  <h2>How it works</h2>
  <ul>
    <li>
      An <a href={page_path(:error_summary)}>error summary</a>
      at the top links to each field with a problem.
    </li>
    <li>Each field shows its own error, in the same words, above the input.</li>
  </ul>
  <p class="spec">
    The same components as the Tax credit letters tab, given a made-up changeset that failed to save.
  </p>
</.shell>
