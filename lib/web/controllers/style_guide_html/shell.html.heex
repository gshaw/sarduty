<% {group, group_title, _about, _pages} = group_of(@current) %>
<div class="container guide">
  <.side_nav label="Style guide">
    <:section
      :for={{links, i} <- Enum.with_index(nav_sections(@current))}
      class={if i == 0, do: "guide-groups", else: "guide-pages"}
    >
      <Web.Layouts.nav_link :for={link <- links} link={link} id_prefix="side-nav-" />
    </:section>
    <:section>
      <.theme_switch />
    </:section>
  </.side_nav>
  <main class="guide-main">
    <.breadcrumbs>
      <:item :if={@current != :index} label="Style guide" path={page_path(:index)} />
      <:item :if={group != @current} label={group_title} path={page_path(group)} />
      <:item label={page_title(@current)} />
    </.breadcrumbs>
    {render_slot(@inner_block)}
  </main>
</div>
