<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{@title} · SAR Duty style guide</title>
    <%!-- The bar's navy, as in the app, so iOS fills the area under the clock with it. --%>
    <meta name="theme-color" content="#13243a" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a111b" media="(prefers-color-scheme: dark)" />
    <script>
      // Before first paint, so a saved theme doesn't flash. A chosen theme also sets the
      // browser's colour, which otherwise follows the system's.
      (function () {
        var navy = { light: "#13243a", dark: "#0a111b" };
        window.setThemeColor = function (theme) {
          document.querySelectorAll('meta[name="theme-color"]').forEach(function (meta) {
            var system = meta.media.indexOf("dark") >= 0 ? "dark" : "light";
            meta.content = navy[theme || system];
          });
        };
        var theme = localStorage.getItem("styles-theme");
        if (theme) document.documentElement.dataset.theme = theme;
        window.setThemeColor(theme);
      })();
    </script>
    <Web.Layouts.favicon_links />
    <%!-- The app's stylesheet, so every example looks as it does in the app. --%>
    <link rel="stylesheet" href={~p"/assets/css/app.css"} />
    <.styles />
  </head>
  <body>
    <% {current_group, _title, _about, current_pages} = group_of(@current) %>
    <header class="guide-bar">
      <div class="container">
        <a href="/" class="brand">SAR <span>Duty</span><small>Style guide</small></a>
        <nav class="guide-tabs" aria-label="Style guide sections">
          <a
            :for={{group, title, _about, _pages} <- groups()}
            href={page_path(group)}
            aria-current={group == current_group && "true"}
          >
            {title}
          </a>
        </nav>
        <div class="theme-switch" role="group" aria-label="Theme">
          <button type="button" data-theme-choice="">Auto</button>
          <button type="button" data-theme-choice="light">Light</button>
          <button type="button" data-theme-choice="dark">Dark</button>
        </div>
      </div>
    </header>
    <div class="container guide">
      <nav class="guide-nav" aria-label="Pages">
        <ul>
          <li :for={{page, title, _about} <- current_pages}>
            <a href={page_path(page)} aria-current={@current == page && "page"}>{title}</a>
          </li>
        </ul>
      </nav>
      <main class="guide-main">
        {render_slot(@inner_block)}
      </main>
    </div>
    <script>
      // iOS Safari only applies :active, the pressed look, when a touch listener exists.
      document.addEventListener("touchstart", function () {}, { passive: true });

      (function () {
        var buttons = document.querySelectorAll("[data-theme-choice]");
        function show() {
          var current = document.documentElement.dataset.theme || "";
          buttons.forEach(function (b) {
            b.setAttribute("aria-pressed", b.dataset.themeChoice === current);
          });
        }
        buttons.forEach(function (b) {
          b.addEventListener("click", function () {
            var theme = b.dataset.themeChoice;
            if (theme) {
              document.documentElement.dataset.theme = theme;
              localStorage.setItem("styles-theme", theme);
            } else {
              delete document.documentElement.dataset.theme;
              localStorage.removeItem("styles-theme");
            }
            window.setThemeColor(theme);
            show();
          });
        });
        show();
      })();
    </script>
  </body>
</html>
