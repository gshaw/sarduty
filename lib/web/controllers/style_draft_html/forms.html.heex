<.shell title="Forms" current={:forms}>
  <h1>Forms</h1>
  <p class="lead">
    Bold labels above, hints under them, errors listed at the top and on the field.
  </p>

  <h2>Team settings, with errors</h2>
  <div class="error-summary" role="alert">
    <h2>There is a problem</h2>
    <ul>
      <li><a href="#authorized_by">Enter who authorizes tax letters</a></li>
      <li><a href="#d4h_key">The D4H access key was not accepted by D4H</a></li>
    </ul>
  </div>
  <form onsubmit="return false">
    <div class="field">
      <label for="name">Team name</label>
      <input id="name" type="text" value="Squamish SAR" />
    </div>
    <div class="grid-2">
      <div class="field">
        <label for="lat">Latitude</label>
        <input id="lat" type="text" value="49.7553" readonly />
      </div>
      <div class="field">
        <label for="lng">Longitude</label>
        <input id="lng" type="text" value="-123.1311" readonly />
      </div>
    </div>
    <div class="field narrow">
      <label for="tz">Time zone</label>
      <select id="tz"><option>America/Vancouver</option><option>America/Edmonton</option></select>
    </div>
    <div class="field">
      <label for="address">Mailing address</label>
      <textarea id="address" rows="3">PO Box 123
Squamish BC V8B 0A1</textarea>
    </div>
    <div class="field field-error">
      <label for="authorized_by">Tax letters authorized by</label>
      <span class="hint">
        Full name, title, address, and phone of the president or a similar role. CRA uses it
        in audits.
      </span>
      <span class="error-message">Enter who authorizes tax letters</span>
      <textarea id="authorized_by" rows="3"></textarea>
    </div>
    <div class="field field-error">
      <label for="d4h_key">D4H access key</label>
      <span class="hint">One key for every D4H request. Stored encrypted.</span>
      <span class="error-message">The D4H access key was not accepted by D4H</span>
      <input id="d4h_key" type="password" value="not-a-real-key" />
    </div>
    <fieldset>
      <legend>Nightly refresh</legend>
      <label class="check"><input type="checkbox" checked /> Refresh from D4H every night</label>
      <label class="check"><input type="checkbox" /> Email me when a refresh fails</label>
    </fieldset>
    <div class="actions">
      <button class="btn">Save settings</button>
      <button type="button" class="btn secondary">Refresh from D4H</button>
    </div>
  </form>

  <hr />

  <h2>Group qualification rules</h2>
  <p class="muted">Define which qualifications members must hold to belong to this group.</p>
  <div :for={clause <- clauses()} class="clause">
    <div class="clause-head">
      <input
        type="text"
        value={clause.name}
        placeholder="Name, e.g. First Aid"
        aria-label="Clause name"
      />
      <span class="grow muted">Member must hold any of:</span>
      <button class="btn sm danger">Delete clause</button>
    </div>
    <div class="chips">
      <span
        :for={q <- clause.qualifications}
        class={["chip", String.starts_with?(q, "Missing") && "missing"]}
      >
        {q}<button title="Remove" aria-label={"Remove #{q}"}>&times;</button>
      </span>
      <span :if={clause.qualifications == []} class="muted small"><em>No qualifications yet</em></span>
    </div>
    <div class="clause-add">
      <select aria-label="Qualification">
        <option>Add qualification…</option>
        <option>Rope Rescue Technician</option>
        <option>Swiftwater Rescue</option>
      </select>
      <button class="btn sm secondary">Add</button>
    </div>
  </div>
  <div class="actions">
    <button class="btn secondary">Add clause</button>
    <button class="btn">Done</button>
  </div>

  <hr />

  <h2>Import attendance</h2>
  <form onsubmit="return false">
    <div class="field">
      <label for="import">Attendance report</label>
      <span class="hint">
        Paste the report exported by SAR Assist. Members are matched by name, email, or phone.
        You review every change before it's made.
      </span>
      <textarea id="import" rows="8"></textarea>
    </div>
    <button class="btn">Import attendance</button>
  </form>
</.shell>
