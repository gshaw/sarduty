#!/bin/sh
set -eu

# Restore the database from the replica when the volume has none
if [ ! -f "$DATABASE_PATH" ]; then
  litestream restore -if-replica-exists -config /app/litestream.yml "$DATABASE_PATH"
fi

# Litestream runs the app as its child: it passes Fly's SIGTERM on, waits for the app
# to stop, then syncs the last writes to R2 before it exits.
cd -P -- "$(dirname -- "$0")"
export PHX_SERVER=true
exec litestream replicate -config /app/litestream.yml -exec "./sarduty start"
