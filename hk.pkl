// Generated by stet from .stet.toml. Edit that file and run `stet sync`.
// Every repo's pre-commit hook: check-only, no stash, the staged files only. hk's global
// hook in ~/.gitconfig runs it. `hk fix --all` fixes what it can. The repo's own steps go
// below the marker line at the end, as `repo_steps`.
amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Builtins.pkl"

hooks {
  ["pre-commit"] {
    fix = false
    stash = "none"
  }
}

steps {
  ["stet"] {
    check = "stet check --check-only --files {{files}}"
    fix = "stet check --files {{files}}"
  }
  ...repo_steps
}

// ---- Below this line: this repo's own steps. stet sync leaves them as they are. ----
// Elixir, check-only on the staged files: the files .formatter.exs formats and the
// folders .credo.exs reads. Compiling, unused deps and tests stay in CI.
local repo_steps = new Mapping<String, Step> {
  ["mix_fmt"] = (Builtins.mix_fmt) {
    glob = List(
      "{mix,.formatter,.credo,.iex}.exs",
      "{config,lib,test}/**/*.{ex,exs,heex}",
      "priv/*/seeds.exs",
      "priv/*/migrations/*.exs"
    )
  }
  ["credo"] {
    glob = List("{lib,test}/**/*.{ex,exs}")
    check = "mix credo --strict {{files}}"
    // Both run Mix in the same _build; one at a time.
    depends = List("mix_fmt")
  }
}
