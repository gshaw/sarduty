select id, member, qualification, ends_at
from awards
where expiring(:within) = true
order by ends_at
search member.name, qualification.title
filter within 'Within' default 60 required
  option 30 '30 days'
  option 60 '60 days'
  option 90 '90 days'
  option 180 '180 days'
filter group 'Group'
  each group where member.groups includes (:group)
