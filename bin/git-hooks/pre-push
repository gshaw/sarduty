#!/bin/sh
# Runs CI's static checks before a push, so a format, Credo, or spelling slip fails
# here in seconds instead of in CI. It checks the working tree, not the pushed commits.
# Skip it once with `git push --no-verify`.
# Turn it on per clone: git config core.hooksPath bin/git-hooks

# GUI apps and agent shells may start without mise on PATH.
export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:/opt/homebrew/bin:$PATH"
export MAPBOX_ACCESS_TOKEN="${MAPBOX_ACCESS_TOKEN:-dummy}"

echo "pre-push: mise run ci-static-analysis (skip with --no-verify)"
if ! mise run -c ci-static-analysis; then
  echo "pre-push: checks failed; run mise run check to fix, then push again" >&2
  exit 1
fi
